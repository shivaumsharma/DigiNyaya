# DigiNyaya backend configuration — copy to ".env" and fill in real values.
# ".env" is git-ignored. NEVER commit real tokens.

# --- Local LLM (Ollama) ---
DIGINYAYA_USE_LLM=1
DIGINYAYA_LLM_MODEL=qwen2.5:1.5b
DIGINYAYA_EMBED_MODEL=nomic-embed-text
DIGINYAYA_OLLAMA_URL=http://localhost:11434

# --- Sarvam AI (production LLM/OCR/STT/TTS/translation provider) ---
# Get a key at https://www.sarvam.ai/ — required for DIGINYAYA_LLM_PROVIDER=sarvam
# and for Document AI OCR, Speech-to-Text, Bulbul TTS, and Mayura translation.
SARVAM_API_KEY=paste-your-sarvam-key-here

# --- Session signing secret (optional; random per-process if unset) ---
# DIGINYAYA_SECRET=change-me-to-a-long-random-string

# --- JWT signing secret (optional; random per-process if unset) ---
# Leaving this unset means every process restart invalidates every logged-in
# session (this was the root cause of the "repeated login prompts" issue
# documented in README's Known Issues) -- set a stable value in production.
# DIGINYAYA_JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Bare path = sqlite (local dev default, no value needed to just use the
# default). Set to a full SQLAlchemy URL to point at Postgres (e.g. AWS RDS):
# DIGINYAYA_DB=diginyaya.db
# DIGINYAYA_DB=postgresql+psycopg://user:password@host:5432/diginyaya

# --- Frontend URL (CORS origin + email verification/reset links) ---
# DIGINYAYA_FRONTEND_URL=http://localhost:5173

# --- File storage ---
# local (default, dev-only) or s3 (see app/storage/s3.py). DIGINYAYA_S3_BUCKET
# is required when DIGINYAYA_STORAGE_PROVIDER=s3; bucket credentials/region
# come from the normal AWS credential chain (aws configure locally, an
# instance role in production), never from an env var here.
# DIGINYAYA_STORAGE_PROVIDER=local
# DIGINYAYA_S3_BUCKET=diginyaya-documents-<account-id>

# --- Background job pool size (app/jobs.py) ---
# Caps how many pipeline/resolution/extraction/discrepancy runs can execute
# concurrently on this instance (queues, doesn't drop, once full). Default 4
# is sized for a small instance (e.g. the free-tier t3.micro EB environment,
# 1 vCPU) -- raise it if running on bigger compute.
# DIGINYAYA_JOB_WORKERS=4

# --- Indian Kanoon API (for scripts/ingest_judgments.py) ---
# Get a token at https://api.indiankanoon.org/  — billed per call.
DIGINYAYA_INDIANKANOON_TOKEN=paste-your-regenerated-token-here

# --- HuggingFace (for scripts/source_free_judgments.py — free, no billing) ---
# Free account + read token at https://huggingface.co/settings/tokens. Also
# needs a one-time click-through of any access terms on the dataset's own
# page (e.g. https://huggingface.co/datasets/opennyaiorg/InJudgements_dataset).
HUGGINGFACE_TOKEN=paste-your-read-token-here
