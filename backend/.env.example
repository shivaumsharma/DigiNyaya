# DigiNyaya backend configuration — copy to ".env" and fill in real values.
# ".env" is git-ignored. NEVER commit real tokens.

# --- Local LLM (Ollama) ---
DIGINYAYA_USE_LLM=1
DIGINYAYA_LLM_MODEL=qwen2.5:1.5b
DIGINYAYA_EMBED_MODEL=nomic-embed-text
DIGINYAYA_OLLAMA_URL=http://localhost:11434

# --- Session signing secret (optional; random per-process if unset) ---
# DIGINYAYA_SECRET=change-me-to-a-long-random-string

# --- Indian Kanoon API (for scripts/ingest_judgments.py) ---
# Get a token at https://api.indiankanoon.org/  — billed per call.
DIGINYAYA_INDIANKANOON_TOKEN=paste-your-regenerated-token-here
