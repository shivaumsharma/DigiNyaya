backend/data_cache/

# Citizen-uploaded case documents (local storage backend's default root)
backend/uploads/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Editor / OS
.DS_Store
.vscode/
*.log

# Claude Code local tool state (includes ad-hoc worktrees) — not project source
.claude/
